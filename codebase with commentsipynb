Tesla T4, pci bus id: 0000:00:05.0, compute capability: 7.5\n","output_type":"stream"},{"name":"stdout","text":"Saved figure: /kaggle/working/figures/10_augmentation_examples.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x560 with 12 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Batch: (32, 224, 224, 3) <dtype: 'float32'> | pixel range: 0.0 - 255.0 | labels: [4 0 0 0 0 0 0 1 3 0]\n","output_type":"stream"}],"execution_count":11},{"cell_type":"markdown","source":"Cell 10: Model builder and training functions","metadata":{}},{"cell_type":"code","source":"BACKBONES = {   # constructor, last convolutional layer (used by Grad-CAM later)\n    \"EfficientNetB3\": (tf.keras.applications.EfficientNetB3, \"top_activation\"),\n    \"ResNet50\": (tf.keras.applications.ResNet50, \"conv5_block3_out\"),\n    \"MobileNetV2\": (tf.keras.applications.MobileNetV2, \"out_relu\"),\n}\n\ndef build_model(backbone, dropout=CFG[\"DROPOUT\"]):\n    \"\"\"ImageNet-pretrained backbone (no top) + custom regularised classification head.\"\"\"\n    ctor, _ = BACKBONES[backbone]\n    base = ctor(weights=CFG[\"WEIGHTS\"], include_top=False, input_shape=(IMG_SIZE, IMG_SIZE, 3))\n    base.trainable = False                                            # phase 1: frozen\n    x = layers.GlobalAveragePooling2D(name=\"gap\")(base.output)       # feature maps -> 1 vector\n    x = layers.BatchNormalization(name=\"head_bn\")(x)\n    x = layers.Dropout(dropout, name=\"head_dropout1\")(x)\n    x = layers.Dense(256, activation=\"relu\", kernel_regularizer=regularizers.l2(1e-4), name=\"head_dense\")(x)\n    x = layers.Dropout(dropout / 2, name=\"head_dropout2\")(x)\n    out = layers.Dense(CFG[\"NUM_CLASSES\"], activation=\"softmax\", dtype=\"float32\", name=\"stage_output\")(x)\n    return models.Model(base.input, out, name=f\"DR_{backbone}\"), base\n\ndef unfreeze_top(base, fraction=CFG[\"UNFREEZE_FRACTION\"]):\n    \"\"\"Phase 2: unfreeze the top `fraction` of backbone layers. BatchNorm stays frozen to keep pretrained statistics.\"\"\"\n    base.trainable = True\n    cut = int(len(base.layers) * (1 - fraction))\n    for i, layer in enumerate(base.layers):\n        layer.trainable = i >= cut and not isinstance(layer, layers.BatchNormalization)\n    return sum(l.trainable for l in base.layers)\n\nclass QWKCallback(tf.keras.callbacks.Callback):\n    \"\"\"Custom callback: Quadratic Weighted Kappa on the validation set after every epoch.\"\"\"\n    def __init__(self, val_ds, y_true):\n        super().__init__(); self.val_ds, self.y_true, self.scores = val_ds, y_true, []\n    def on_epoch_end(self, epoch, logs=None):\n        pred = np.argmax(self.model.predict(self.val_ds, verbose=0), axis=1)\n        qwk = cohen_kappa_score(self.y_true, pred, weights=\"quadratic\")\n        self.scores.append(qwk)\n        if logs is not None:\n            logs[\"val_qwk\"] = qwk\n        print(f\" - val_qwk: {qwk:.4f}\")\n\ndef compile_model(model, lr):\n    model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=lr),\n                  loss=\"sparse_categorical_crossentropy\", metrics=[\"accuracy\"])\n\ndef fit_phase(model, train_ds, val_ds, y_val_true, epochs, tag, patience):\n    \"\"\"One training phase with the full callback set.\"\"\"\n    qwk_cb = QWKCallback(val_ds, y_val_true)\n    cbs = [\n        qwk_cb,\n        tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=patience, restore_best_weights=True, verbose=1),\n        tf.keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.3, patience=2, min_lr=1e-7, verbose=1),\n        tf.keras.callbacks.ModelCheckpoint(os.path.join(MODEL_DIR, f\"{tag}.weights.h5\"), monitor=\"val_loss\",\n                                           save_best_only=True, save_weights_only=True),\n        tf.keras.callbacks.CSVLogger(os.path.join(MODEL_DIR, f\"{tag}_log.csv\")),\n    ]\n    h = model.fit(train_ds, validation_data=val_ds, epochs=epochs, class_weight=CLASS_WEIGHTS,\n                  callbacks=cbs, verbose=2)\n    hist = {k: list(v) for k, v in h.history.items()}\n    hist[\"val_qwk\"] = qwk_cb.scores[:len(hist[\"loss\"])]\n    return hist\n\ndef train_two_phase(backbone, variant, lr_head):\n    \"\"\"Phase 1 (frozen backbone) + phase 2 (fine-tune top layers). Returns model, history, phase-1 length, seconds.\"\"\"\n    set_seed()\n    X = X_variants[variant]\n    tr = make_ds(X[idx_train], y_train, backbone, training=True)\n    va = make_ds(X[idx_val], y_val, backbone)\n    model, base = build_model(backbone)\n    t0 = time.time()\n\n    compile_model(model, lr_head)\n    print(f\"\\n=== {backbone} | {variant} | Phase 1: frozen backbone, LR={lr_head} ===\")\n    h1 = fit_phase(model, tr, va, y_val, CFG[\"EPOCHS_HEAD\"], f\"{backbone}_{variant}_p1\", patience=4)\n\n    n_unfrozen = unfreeze_top(base)\n    compile_model(model, CFG[\"LR_FINETUNE\"])\n    print(f\"\\n=== Phase 2: fine-tuning {n_unfrozen} backbone layers, LR={CFG['LR_FINETUNE']} ===\")\n    h2 = fit_phase(model, tr, va, y_val, CFG[\"EPOCHS_FINETUNE\"], f\"{backbone}_{variant}_p2\", patience=6)\n\n    hist = {k: h1.get(k, [np.nan] * len(h1[\"loss\"])) + h2.get(k, [np.nan] * len(h2[\"loss\"]))\n            for k in set(h1) | set(h2)}\n    return model, hist, len(h1[\"loss\"]), time.time() - t0\n\ndef plot_history(hist, split_at, title, fname):\n    \"\"\"Accuracy, loss and QWK curves with a marker where fine-tuning starts.\"\"\"\n    fig, axes = plt.subplots(1, 3, figsize=(17, 4.2))\n    ep = np.arange(1, len(hist[\"loss\"]) + 1)\n    for ax, key, name in zip(axes, [\"accuracy\", \"loss\", \"qwk\"], [\"Accuracy\", \"Loss\", \"Quadratic Weighted Kappa\"]):\n        if key != \"qwk\":\n            ax.plot(ep, hist[key], \"o-\", ms=3, label=\"Train\")\n        ax.plot(ep, hist[f\"val_{key}\"], \"o-\", ms=3, label=\"Validation\")\n        ax.axvline(split_at + 0.5, color=\"grey\", ls=\"--\", label=\"Start fine-tuning\")\n        ax.set_title(name); a