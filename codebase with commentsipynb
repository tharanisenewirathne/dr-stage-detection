y one variable changes) and cheap.\"\"\"\n    set_seed()\n    t0 = time.time()\n    X = X_variants[variant]\n    model, _ = build_model(backbone)\n    compile_model(model, lr)\n    qwk_cb = QWKCallback(make_ds(X[idx_val], y_val, backbone), y_val)\n    h = model.fit(make_ds(X[idx_train], y_train, backbone, training=True),\n                  validation_data=make_ds(X[idx_val], y_val, backbone),\n                  epochs=CFG[\"ABLATION_EPOCHS\"], class_weight=CLASS_WEIGHTS, callbacks=[qwk_cb], verbose=0)\n    res = dict(best_val_qwk=max(qwk_cb.scores), best_val_acc=max(h.history[\"val_accuracy\"]),\n               min_val_loss=min(h.history[\"val_loss\"]))\n    print(f\"[{variant} | lr={lr}] done in {time.time() - t0:.0f}s -> val QWK {res['best_val_qwk']:.4f}, val acc {res['best_val_acc']:.4f}\")\n    del model; tf.keras.backend.clear_session(); gc.collect()\n    return res\n\n# ---- Experiment 1: which preprocessing helps most? ----\nBEST_VARIANT = \"clahe\"\nif CFG[\"RUN_ABLATION\"]:\n    abl = pd.DataFrame({v: quick_run(v, CFG[\"LR_HEAD\"]) for v in VARIANTS}).T\n    display(abl.round(4))\n    BEST_VARIANT = abl[\"best_val_qwk\"].idxmax()\n    abl.to_csv(os.path.join(CFG[\"OUT_DIR\"], \"ablation_preprocessing.csv\"))\n    ax = abl[[\"best_val_qwk\", \"best_val_acc\"]].plot(kind=\"bar\", figsize=(8, 4), colormap=\"Set2\")\n    for c in ax.containers: ax.bar_label(c, fmt=\"%.3f\", fontsize=9)\n    plt.title(\"Preprocessing ablation (frozen EfficientNetB3, validation set)\"); plt.xticks(rotation=0); plt.ylim(0, 1.05)\n    save_fig(\"11_ablation_preprocessing\"); plt.show()\nprint(\"Selected preprocessing:\", BEST_VARIANT)\n\n# ---- Experiment 2: which head learning rate? ----\nif CFG[\"RUN_LR_SWEEP\"]:\n    lrs = [1e-3, 3e-4, 1e-4]\n    sweep = pd.DataFrame({lr: quick_run(BEST_VARIANT, lr) for lr in lrs}).T\n    sweep.index.name = \"learning_rate\"\n    display(sweep.round(4))\n    CFG[\"LR_HEAD\"] = float(sweep[\"best_val_qwk\"].idxmax())\n    sweep.to_csv(os.path.joi