]\ngrad_model = tf.keras.Model(best_model.inputs, [best_model.get_layer(LAST_CONV).output, best_model.output])\n\ndef gradcam(img_uint8, class_idx=None):\n    \"\"\"Heatmap (0-1, image size) of regions that drove the prediction, plus the class probabilities.\"\"\"\n    x = PREPROC[BEST_BB](tf.cast(img_uint8[None], tf.float32))\n    with tf.GradientTape() as tape:\n        conv, preds = grad_model(x)\n        if class_idx is None:\n            class_idx = int(tf.argmax(preds[0]))\n        score = preds[:, class_idx]\n    grads = tape.gradient(score, conv)\n    weights = tf.reduce_mean(grads, axis=(0, 1, 2))                  # importance of each feature map\n    cam = tf.nn.relu(tf.reduce_sum(conv[0] * weights, axis=-1)).numpy()\n    cam = cv2.resize(cam, (img_uint8.shape[1], img_uint8.shape[0]))\n    cam = cam / (cam.max() + 1e-8) * MASK                              # normalise, ignore outside retina\n    return cam, preds[0].numpy()\n\ndef overlay(img, cam, alpha=0.4):\n    heat = cv2.applyColorMap(np.uint8(255 * cam), cv2.COLORMAP_JET)[..., ::-1]\n    return np.uint8(img * (1 - alpha) + heat * alpha)\n\n# Two test images per class (correctly classified where possible); show the ORIGINAL photo + overlay\npicks = []\nfor c in range(5):\n    cand = [i for i in np.where(y_test == c)[0] if final_pred[i] == c] or list(np.where(y_test == c)[0])\n    picks += cand[:2]\nfig, axes = plt.subplots(5, 4, figsize=(14, 18))\nfor k, i in enumerate(picks):\n    cam, p = gradcam(X_test_v[i])\n    shown = X_base[idx_test[i]]\n    r, c0 = k // 2, (k % 2) * 2\n    axes[r, c0].imshow(shown); axes[r, c0].set_title(f\"True: {CLASS_NAMES[y_test[i]]}\", fontsize=10)\n    axes[r, c0 + 1].imshow(overlay(shown, cam)); axes[r, c0 + 1].set_title(f\"Pred: {CLASS_NAMES[p.argmax()]} ({p.max():.0%})\", fontsize=10)\nfor a in axes.ravel(): a.axis(\"off\")\nplt.suptitle(f\"Grad-CAM — {BEST_BB}\", fontsize=13); plt.tight_layout()\nsave_fig(\"21_gradcam\"); plt.show()","metadata":{"trusted":true,"execut