xlabel(\"\")\nplt.tight_layout(); save_fig(\"06_quality_metrics\"); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T12:08:08.486726Z","iopub.execute_input":"2026-10-01T12:08:08.487349Z","iopub.status.idle":"2026-10-01T12:08:33.156854Z","shell.execute_reply.started":"2026-10-01T12:08:08.487318Z","shell.execute_reply":"2026-10-01T12:08:33.156168Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"           RMS contrast  Entropy (bits)  Sharpness (Laplacian var)\nvariant                                                           \nraw               26.18            5.73                      85.16\nclahe             31.02            6.28                     590.28\nbengraham         33.66            6.61                    2229.17","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>RMS contrast</th>\n      <th>Entropy (bits)</th>\n      <th>Sharpness (Laplacian var)</th>\n    </tr>\n    <tr>\n      <th>variant</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>raw</th>\n      <td>26.18</td>\n      <td>5.73</td>\n      <td>85.16</td>\n    </tr>\n    <tr>\n      <th>clahe</th>\n      <td>31.02</td>\n      <td>6.28</td>\n      <td>590.28</td>\n    </tr>\n    <tr>\n      <th>bengraham</th>\n      <td>33.66</td>\n      <td>6.61</td>\n      <td>2229.17</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"Saved figure: /kaggle/working/figures/06_quality_metrics.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x380 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":7},{"cell_type":"markdown","source":"Cell 6: Colour channels, edges, segmentation and labelling (LO1, LO3)","metadata":{}},{"cell_type":"code","source":"def green_clahe(img):\n    \"\"\"Green channel with CLAHE: the standard representation for retinal vessel analysis.\"\"\"\n    return cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8)).apply(img[..., 1])\n\ndef retina_mask_otsu(img):\n    \"\"\"Otsu thresholding separates the retina from the black background.\"\"\"\n    g = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)\n    _, m = cv2.threshold(g, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n    return cv2.erode(m, np.ones((5, 5), np.uint8))     # shrink slightly to drop the bright rim\n\ndef vessel_segmentation(img, roi):\n    \"\"\"Morphological black-hat (closing - image) highlights thin dark structures = vessels.\"\"\"\n    g = green_clahe(img)\n    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))\n    blackhat = cv2.morphologyEx(g, cv2.MORPH_BLACKHAT, k)\n    _, v = cv2.threshold(blackhat, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n    v = cv2.bitwise_and(v, roi)\n    return cv2.morphologyEx(v, cv2.MORPH_OPEN, np.ones((2, 2), np.uint8))\n\ndef bright_lesion_labelling(img, roi, min_area=4):\n    \"\"\"White top-hat finds small bright spots (exudate candidates); connected components labels each one.\"\"\"\n    g = green_clahe(img)\n    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))\n    tophat = cv2.morphologyEx(g, cv2.MORPH_TOPHAT, k)\n    thr = max(np.percentile(tophat[roi > 0], 99.5), 20)\n    cand = ((tophat > thr) & (roi > 0)).astype(np.uint8)\n    n, lab, stats, _ = cv2.connectedComponentsWithStats(cand, connectivity=8)\n    keep = [i for i in range(1, n) if stats[i, cv2.CC_STAT_AREA] >= min_area]\n    colours = np.zeros((*lab.shape, 3), np.uint8)\n    rng = np.random.default_rng(0)\n    for i in keep:\n        colours[lab == i] = rng.integers(60, 255, 3)    # each labelled region gets its own colour\n    return colours, len(keep)\n\n# One healthy and one severe/proliferative image for contrast\ndemo = [df[df[\"label\"] == 0][\"path\"].iloc[0], df[df[\"label\"] >= 3][\"path\"].iloc[0]]\nfig, axes = plt.subplots(len(demo), 8, figsize=(26, 3.6 * len(demo)))\nfor r, p in enumerate(demo):\n    img = base_preprocess(p, size=448)              # higher resolution for fine structures\n    roi = retina_mask_otsu(img)\n    gc_img = green_clahe(img)\n    sob = cv2.magnitude(cv2.Sobel(gc_img, cv2.CV_32F, 1, 0), cv2.Sobel(gc_img, cv2.CV_32F, 0, 1))\n    can = cv2.Canny(gc_img, 50, 150) * (roi > 0)\n    ves = vessel_segmentation(img, roi)\n    les, nles = bright_lesion_labelling(img, roi)\n    label = CLASS_NAMES[int(df.loc[df.path == p, \"label\"].iloc[0])]\n    panels = [(img, f\"RGB ({label})\", None), (img[..., 0], \"Red channel\", \"gray\"),\n              (img[..., 1], \"Green channel\", \"gray\"), (img[..., 2], \"Blue channel\", \"gray\"),\n              (sob, \"Sobel magnitude\", \"magma\"), (can, \"Canny edges\", \"gray\"),\n              (ves, \"Vessel segmentation\", \"gray\"), (les, f\"Labelled bright lesions: {nles}\", None)]\n    for ax, (im, t, cm) in zip(axes[r], panels):\n        ax.imshow(im, cmap=cm); ax.set_title(t, fontsize=10); ax.axis(\"off\")\nplt.tight_layout(); save_fig(\"07_representation_segmentation_labelling\"); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T12:09:31.924695Z","iopub.execute_input":"2026-10-01T12:09:31.925166Z","iopub.status.idle":"2026-10-01T12:09:35.885629Z","shell.execute_reply.started":"2026-10-01T12:09:31.925133Z","shell.execute_reply":"2026-10-01T12:09:35.884313Z"}},"outputs":[{"name":"stdout","text":"Saved figure: /kaggle/working/figures/07_representation_segmentation_labelling.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2600x720 with 16 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":8},{"cell_type":"markdown","source":"Cell 7: Process all images once, then remove duplicates","metadata":{}},{"cell_type":"code","source":"def _work(path):\n    \"\"\"Worker for parallel preprocessing; returns a black image if a file is unreadable.\"\"\"\n    try:\n        return base_preprocess(path)\n    except Exception as e:\n        print(\"Failed:\", path, e)\n        return np.zeros((IMG_SIZE, IMG_SIZE, 3), np.uint8)\n\ncache_file = os.path.join(CFG[\"OUT_DIR\"], f\"base_cache_{IMG_SIZE}_{len(df)}.npy\")\nt0 = time.time()\nif os.path.exists(cache_file):\n    X_base = np.load(cache_file)\nelse:\n    with ProcessPoolExecutor(max_workers=os.cpu_count()) as ex:\n        X_base = np.stack(list(ex.map(_work, df[\"path\"], chunksize=16)))\n    np.save(cache_file, X_base)\nprint(f\"Base cache: {X_base.shape}, {X_base.nbytes / 1e6:.0f} MB, {time.time() - t0:.0f}s\")\n\n# ---- Duplicate detection with a difference hash (dHash) ----\ndef dhash(img, size=16):\n    \"\"\"Compare neighbouring pixels of a tiny grey image -> 256-bit fingerprint of the photo.\"\"\"\n    g = cv2.resize(cv2.cvtColor(img, cv2.COLOR_RGB2GRAY), (size + 1, size), interpolation=cv2.INTER_AREA)\n    bits = (g[:, 1:] > g[:, :-1]).flatten()\n    return hashlib.md5(np.packbits(bits).tobytes()).hexdigest()\n\ndf[\"hash\"] = [dhash(im) for im in X_base]\ngroups = df.groupby(\"hash\")[\"label\"].agg([\"count\", \"nunique\"])\ndup_groups = groups[groups[\"count\"] > 1]\nconflict = groups[groups[\"nunique\"] > 1].index\nprint(f\"Duplicate groups: {len(dup_groups)} (images involved: {dup_groups['count'].sum()})\")\nprint(f\"Groups with conflicting grades: {len(conflict)} -> removed entirely\")\n\n# Drop conflicting groups completely; for consistent duplicates keep the first copy only\nkeep = ~df[\"hash\"].isin(conflict) & ~df.duplicated(\"hash\", keep=\"first\")\nremoved = len(df) - keep.sum()\ndf, X_base = df[keep].reset_index(drop=True), X_base[keep.values]\nprint(f\"Removed {removed} images; {len(df)} remain.\")\n\n# ---- Build the three preprocessing variants from the cached base images ----\nX_variants = {name: np.stack([fn(im) for im in X_base]).astype(np.uint8) for name, fn in VARIANTS.items()}\ny_all = df[\"label\"].values\nprint({k: v.shape for k, v in X_variants.items()})","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T12:16:30.785226Z","iopub.execute_input":"2026-10-01T12:16:30.786048Z","iopub.status.idle":"2026-10-01T12:19:33.559717Z","shell.execute_reply.started":"2026-10-01T12:16:30.786016Z","shell.execute_reply":"2026-10-01T12:19:33.558679Z"}},"outputs":[{"name":"stdout","text":"Base cache: (3662, 224, 224, 3), 551 MB, 155s\nDuplicate groups: 130 (images involved: 265)\nGroups with conflicting grades: 36 -> removed entirely\nRemoved 171 images; 3491 remain.\n{'raw': (3491, 224, 224, 3), 'clahe': (3491, 224, 224, 3), 'bengraham': (3491, 224, 224, 3)}\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"Cell 8: Stratified 70 / 10 / 20 split","metadata":{}},{"cell_type":"code","source":"idx = np.arange(len(df))\n# First carve out the 20% test set, then split the rest into train (70% of total) and validation (10% of total)\nidx_trval, idx_test = train_test_split(idx, test_size=CFG[\"TEST_SIZE\"], stratify=y_all, random_state=CFG[\"SEED\"])\nval_share = CFG[\"VAL_SIZE\"] / (1 - CFG[\"TEST_SIZE\"])\nidx_train, idx_val = train_test_split(idx_trval, test_size=val_share, stratify=y_all[idx_trval], random_state=CFG[\"SEED\"])\ny_train, y_val, y_test = y_all[idx_train], y_all[idx_val], y_all[idx_test]\n\nsplit_table = pd.DataFrame({\n    \"Train\": pd.Series(y_train).value_counts().sort_index(),\n    \"Validation\": pd.Series(y_val).value_counts().sort_index(),\n    \"Test\": pd.Series(y_test).value_counts().sort_index(),\n}).set_axis(CLASS_NAMES)\nsplit_table.loc[\"Total\"] = split_table.sum()\ndisplay(split_table)\n\nsplit_table.drop(\"Total\").plot(kind=\"bar\", figsize=(9, 4), colormap=\"viridis\")\nplt.title(\"Stratified split: each subset keeps the same class prop