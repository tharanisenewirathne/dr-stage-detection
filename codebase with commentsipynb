etadata":{}},{"name":"stdout","text":"Best backbone (validation QWK): EfficientNetB3\nSaved figure: /kaggle/working/figures/14_backbone_comparison_curves.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x420 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"markdown","source":"Cell 13: Test-set evaluation and model comparison","metadata":{}},{"cell_type":"code","source":"X_test_v = X_variants[BEST_VARIANT][idx_test]\n\ndef predict_probs(model, X, bb, tta=False):\n    \"\"\"Class probabilities; with TTA, average over original + horizontal flip + vertical flip.\"\"\"\n    p = model.predict(make_ds(X, np.zeros(len(X), int), bb), verbose=0)\n    if tta:\n        p = p + model.predict(make_ds(X[:, :, ::-1].copy(), np.zeros(len(X), int), bb), verbose=0)\n        p = p + model.predict(make_ds(X[:, ::-1].copy(), np.zeros(len(X), int), bb), verbose=0)\n        p = p / 3\n    return p\n\ndef binary_metrics(y_true, y_pred, thr):\n    \"\"\"Collapse stages into a yes/no decision at threshold `thr` (1 = any DR, 2 = referable DR).\"\"\"\n    t, p = (y_true >= thr).astype(int), (y_pred >= thr).astype(int)\n    tn, fp, fn, tp = confusion_matrix(t, p, labels=[0, 1]).ravel()\n    return dict(sensitivity=tp / max(tp + fn, 1), specificity=tn / max(tn + fp, 1),\n                ppv=tp / max(tp + fp, 1), npv=tn / max(tn + fn, 1))\n\ndef summarize(y_true, probs):\n    y_pred = probs.argmax(1)\n    pr, rc, f1, _ = precision_recall_fscore_support(y_true, y_pred, average=\"macro\", zero_division=0)\n    _, _, f1w, _ = precision_recall_fscore_support(y_true, y_pred, average=\"weighted\", zero_division=0)\n    try:\n        auc = roc_auc_score(y_true, probs, multi_class=\"ovr\", average=\"macro\")\n    except ValueError:\n        auc = np.nan\n    anydr, ref = binary_metrics(y_true, y_pred, 1), binary_metrics(y_true, y_pred, 2)\n    return {\"accuracy\": accuracy_score(y_true, y_pred), \"balanced_acc\": balanced_accuracy_score(y_true, y_pred),\n            \"precision_macro\": pr, \"recall_macro\": rc, \"f1_macro\": f1, \"f1_weighted\": f1w,\n            \"qwk\": cohen_kappa_score(y_true, y_pred, weights=\"quadratic\"), \"auc_macro\": auc,\n            \"anyDR_sens\": anydr[\"sensitivity\"], \"anyDR_spec\": anydr[\"specificity\"],\n            \"referable_sens\": ref[\"sensitivity\"], \"referable_spec\": ref[\"specificity\"]}\n\n# Evaluate every trained backbone + the best one with TTA\nTEST_PROBS, rows = {}, {}\nfor bb, m in TRAINED.items():\n    TEST_PROBS[bb] = predict_probs(m, X_test_v, bb)\n    rows[bb] = summarize(y_test, TEST_PROBS[bb])\nTEST_PROBS[f\"{BEST_BB}+TTA\"] = predict_probs(best_model, X_test_v, BEST_BB, tta=True)\nrows[f\"{BEST_BB}+TTA\"] = summarize(y_test, TEST_PROBS[f\"{BEST_BB}+TTA\"])\ntest_table = pd.DataFrame(rows).T\ntest_table.to_csv(os.path.join(CFG[\"OUT_DIR\"], \"test_results.csv\"))\ndisplay(test_table.round(3))\n\n# Decide on TTA using the VALIDATION set (choosing on test would bias the reported result)\nX_val_v = X_variants[BEST_VARIANT][idx_val]\nval_plain = cohen_kappa_score(y_val, predict_probs(best_model, X_val_v, BEST_BB).argmax(1), weights=\"quadratic\")\nval_tta = cohen_kappa_score(y_val, predict_probs(best_model, X_val_v, BEST_BB, tta=True).argmax(1), weights=\"quadratic\")\nUSE_TTA = val_tta > val_plain\nFINAL_KEY = f\"{BEST_BB}+TTA\" if USE_TTA else BEST_BB\nprint(f\"Validation QWK without TTA {val_plain:.4f} | with TTA {val_tta:.4f} -> final model = {FINAL_KEY}\")\nfinal_probs = TEST_PROBS[FINAL_KEY]; final_pred = final_probs.argmax(1)\n\n# Comparison chart\nmetrics_show = [\"accuracy\", \"balanced_acc\", \"f1_macro\", \"qwk\", \"referable_sens\", \"referable_spec\"]\ntest_table[metrics_show].plot(kind=\"bar\", figsize=(13, 4.5), colormap=\"tab10\", width=0.8)\nplt.title(\"Test-set comparison of models\"); plt.xticks(rotation=0); plt.ylim(0, 1.1)\nplt.legend(ncol=6, loc=\"upper center\", fontsize=8)\nsave_fig(\"15_test_model_comparison\"); plt.show()\n\n# Per-class precision / recall / F1 for the final model\nprint(f\"Final model: {FINAL_KEY}\\n\")\nprint(classification_report(y_test, final_pred, target_names=CLASS_NAMES, digits=3, zero_division=0))\nreport = classification_report(y_test, final_pred, target_names=CLASS_NAMES, output_dict=True, zero_division=0)\nplt.figure(figsize=(6, 3.8))\nsns.heatmap(pd.DataFrame(report).T.iloc[:5, :3], annot=True, fmt=\".2f\", cmap=\"YlGn\", vmin=0, vmax=1)\nplt.title(\"Per-class precision / recall / F1 (test)\"); save_fig(\"16_per_class_metrics\"); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T13:14:24.358798Z","iopub.execute_input":"2026-10-01T13:14:24.359517Z","iopub.status.idle":"2026-10-01T13:15:10.066134Z","shell.execute_reply.started":"2026-10-01T13:14:24.359482Z","shell.execute_reply":"2026-10-01T13:15:10.065485Z"}},"outputs":[{"name":"stderr","text":"2026-10-01 13:14:34.663273: E external/local_xla/xla/stream_executor/cuda/cuda_timer.cc:86] Delay kernel timed out: measured time has sub-optimal accuracy. There may be a missing warmup execution, please investigate in Nsight Systems.\n2026-10-01 13:14:34.810529: E external/local_xla/xla/stream_executor/cuda/cuda_timer.cc:86] Delay kernel timed out: measured time has sub-optimal accuracy. There may be a missing warmup execution, please investigate in Nsight Systems.\n2026-10-01 13:14:35.179384: E external/local_xla/xla/stream_executor/cuda/cuda_timer.cc:86] Delay kernel timed out: measured time has sub-optimal accuracy. There may be a missing warmup execution, please investigate in Nsight Systems.\n2026-10-01 13:14:35.326498: E external/local_xla/xla/stream_executor/cuda/cuda_timer.cc:86] Delay kernel timed out: measured time has sub-optimal accuracy. There may be a missing warmup execution, please investigate in Nsight Systems.\n2026-10-01 13:14:36.137813: E external/local_xla/xla/stream_executor/cuda/cuda_timer.cc:86] Delay kernel timed out: measured time ha