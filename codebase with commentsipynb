nted {i + 1}\", fontsize=10)\nfor a in axes: a.axis(\"off\")\nplt.tight_layout(); save_fig(\"10_augmentation_examples\"); plt.show()\n\n# ---- Backbone-specific input scaling ----\n# Keras EfficientNet contains its own rescaling layer and expects 0-255 pixels,\n# so dividing by 255 here would silently break it. ResNet50 / MobileNetV2 need their own preprocess_input.\nPREPROC = {\n    \"EfficientNetB3\": lambda x: x,\n    \"ResNet50\": tf.keras.applications.resnet50.preprocess_input,\n    \"MobileNetV2\": tf.keras.applications.mobilenet_v2.preprocess_input,\n}\nAUTOTUNE = tf.data.AUTOTUNE\n\ndef make_ds(X, y, backbone, training=False, batch_size=CFG[\"BATCH_SIZE\"]):\n    \"\"\"tf.data pipeline: (shuffle) -> batch -> float -> (augment, train only) -> backbone scaling -> prefetch.\"\"\"\n    ds = tf.data.Dataset.from_tensor_slices((X, y))\n    if training:\n        ds = ds.shuffle(len(X), seed=CFG[\"SEED\"], reshuffle_each_iteration=True)\n    ds = ds.batch(batch_size).map(lambda a, b: (tf.cast(a, tf.float32), b), num_parallel_calls=AUTOTUNE)\n    if training:\n        ds = ds.map(lambda a, b: (tf.clip_by_value(AUGMENT(a, training=True), 0.0, 255.0), b),\n                    num_parallel_calls=AUTOTUNE)\n    fn = PREPROC[backbone]\n    return ds.map(lambda a, b: (fn(a), b), num_parallel_calls=AUTOTUNE).prefetch(AUTOTUNE)\n\n# Quick check that the pipeline produces correctly shaped batches\nxb, yb = next(iter(make_ds(X_variants[\"clahe\"][idx_train[:64]], y_train[:64], \"EfficientNetB3\", training=True)))\nprint(\"Batch:\", xb.shape, xb.dtype, \"| pixel range:\", float(tf.reduce_min(xb)), \"-\", float(tf.reduce_max(xb)), \"| labels:\", yb.numpy()[:10])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T12:22:13.421539Z","iopub.execute_input":"2026-10-01T12:22:13.422336Z","iopub.status.idle":"2026-10-01T12:22:20.742511Z","shell.execute_reply.started":"2026-10-01T12:22:13.422305Z","shell.execute_reply":"2026-10-01T12:22:20.741908Z"}},"outputs":[{"ou