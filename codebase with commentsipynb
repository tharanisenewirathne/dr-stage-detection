ck image: leave unchanged\n        return img\n    rows, cols = np.where(mask.any(axis=1))[0], np.where(mask.any(axis=0))[0]\n    return img[rows[0]:rows[-1] + 1, cols[0]:cols[-1] + 1]\n\ndef pad_to_square(img):\n    \"\"\"Pad with black so the retina is centred in a square image (no distortion when resizing).\"\"\"\n    h, w = img.shape[:2]; s = max(h, w)\n    top, left = (s - h) // 2, (s - w) // 2\n    return cv2.copyMakeBorder(img, top, s - h - top, left, s - w - left, cv2.BORDER_CONSTANT, value=0)\n\ndef circular_mask(size=IMG_SIZE, scale=0.97):\n    \"\"\"Binary disc covering the retina.\"\"\"\n    m = np.zeros((size, size), np.uint8)\n    cv2.circle(m, (size // 2, size // 2), int(size / 2 * scale), 1, -1)\n    return m\n\nMASK = circular_mask()\n\ndef base_preprocess(path, size=IMG_SIZE):\n    \"\"\"Load -> crop retina -> pad to square -> resize. Output: RGB uint8 (size x size).\"\"\"\n    img = crop_to_retina(load_rgb(path))\n    img = pad_to_square(img)\n    return cv2.resize(img, (size, size), interpolation=cv2.INTER_AREA)\n\ndef enhance_clahe(img):\n    \"\"\"Median denoise + CLAHE on luminance + unsharp-mask edge enhancement + circular mask.\"\"\"\n    img = cv2.medianBlur(img, 3)                                   # noise removal\n    lab = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)\n    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n    lab[..., 0] = clahe.apply(lab[..., 0])                         # contrast on lightness only, colours preserved\n    img = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)\n    blur = cv2.GaussianBlur(img, (0, 0), sigmaX=2)\n    img = cv2.addWeighted(img, 1.5, blur, -0.5, 0)                 # unsharp mask = edge enhancement\n    return img * MASK[..., None]\n\ndef enhance_ben_graham(img):\n    \"\"\"Ben Graham: img*4 - GaussianBlur(img)*4 + 128, removes uneven illumination.\"\"\"\n    blur = cv2.GaussianBlur(img, (0, 0), sigmaX=img.shape[0] / 30)\n    img = cv2.addWeighted(img, 4, blur, -4, 128)\n    return img * MASK[..., None]\n\nVARIANTS = {\n    \"raw\": lambda img: img,                    # crop + resize only (baseline)\n    \"clahe\": enhance_clahe,\n    \"bengraham\": enhance_ben_graham,\n}\n\n# ---- Step-by-step visualisation on one Moderate image ----\nexample_path = df[df[\"label\"] == 2][\"path\"].iloc[0]\norig = load_rgb(example_path)\ncropped = crop_to_retina(orig)\nresized = cv2.resize(pad_to_square(cropped), (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_AREA)\ndenoised = cv2.medianBlur(resized, 3)\nlab = cv2.cvtColor(denoised, cv2.COLOR_RGB2LAB)\nlab[..., 0] = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8)).apply(lab[..., 0])\nclahe_img = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)\nfinal = enhance_clahe(resized)\nbg = enhance_ben_graham(resized)\n\nsteps = [(orig, f\"1. Original {orig.shape[1]}x{orig.shape[0]}\"), (cropped, \"2. Retina cropped\"),\n         (resized, f\"3. Padded + resized {IMG_SIZE}x{IMG_SIZE}\"), (denoised, \"4. Median denoised\"),\n         (clahe_img, \"5. CLAHE (L channel)\"), (final, \"6. Unsharp + mask (final)\"),\n         (bg, \"Alt: Ben Graham\")]\nfig, axes = plt.subplots(1, len(steps), figsize=(3.2 * len(steps), 3.6))\nfor ax, (im, t) in zip(axes, steps):\n    ax.imshow(im); ax.set_title(t, fontsize=10); ax.axis(\"off\")\nplt.tight_layout(); save_fig(\"04_preprocessing_steps\"); plt.show()\n\n# ---- Grey-level histogram before/after: shows the contrast stretch ----\nfig, ax = plt.subplots(1, 2, figsize=(12, 3.5))\nfor a, im, t in [(ax[0], resized, \"Before CLAHE\"), (ax[1], final, \"After pipeline\")]:\n    g = cv2.cvtColor(im, cv2.COLOR_RGB2GRAY)[MASK > 0]\n    a.hist(g.ravel(), bins=64, color=\"steelblue\"); a.set_title(f\"{t}: grey-level histogram (inside retina)\")\n    a.set_xlabel(\"Intensity\"); a.set_ylabel(\"Pixels\")\nplt.tight_layout(); save_fig(\"05_histogram_before_after\"); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-01T12:06:23.590516Z","iopub.execute_input":"2026-10-01T12:06:23.590790Z","iopub.